import("//brave/build/config.gni")
import("//brave/components/brave_ads/buildflags/buildflags.gni")
import("//extensions/buildflags/buildflags.gni")

assert(is_android)

source_set("android_browser_process") {
  sources = [
    "brave_feature_util.cc",
    "brave_local_state_android.cc",
    "brave_relaunch_utils.cc",
    "brave_shields_content_settings.cc",
    "brave_shields_content_settings.h",
    "brave_sync_worker.cc",
    "brave_sync_worker.h",
  ]

  deps = [
    "//base",
    "//brave/brave_domains/android:jni_headers",
    "//brave/browser/android/browsing_data",
    "//brave/browser/android/preferences",
    "//brave/browser/android/safe_browsing",
    "//brave/browser/brave_origin/android:jni_headers",
    "//brave/browser/brave_shields",
    "//brave/browser/skus/android:jni_headers",
    "//brave/build/android:jni_headers",
    "//brave/components/brave_ads/buildflags",
    "//brave/components/brave_shields/content/browser",
    "//brave/components/brave_shields/core/browser",
    "//brave/components/brave_shields/core/common",
    "//brave/components/brave_sync",
    "//brave/components/brave_sync:crypto",
    "//brave/components/brave_sync:prefs",
    "//brave/components/brave_sync:sync_service_impl_helper",
    "//brave/components/brave_sync:time_limited_codes",
    "//chrome/android:jni_headers",
    "//chrome/browser:browser_process",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser:flags",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/lifetime",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/sync",
    "//chrome/common",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/browser:cookie_settings",
    "//components/ntp_tiles",
    "//components/prefs",
    "//components/sync",
    "//components/translate/core/browser",
    "//components/unified_consent",
    "//components/webui/flags",
    "//url",
  ]

  if (enable_brave_ads) {
    deps += [
      "//brave/browser/brave_ads/android:jni_headers",
      "//brave/components/brave_ads/browser",
    ]
  }

  if (enable_extensions_core) {
    deps += [ ":extensions_android" ]
  }
}

# Native bridge for Brave's Android extension support
# (org.chromium.chrome.browser.extensions.*). Built only when the extensions
# core is part of the build — desktop, or Android builds made with
# enable_desktop_android_extensions = true.
if (enable_extensions_core) {
  source_set("extensions_android") {
    sources = [
      "extensions/extensions_manager_android.cc",
      "extensions/extensions_manager_android.h",
    ]

    # NOTE: prune/adjust these deps during the first real desktop-android
    # build; the upstream experimental platform (crbug.com/356905053) is
    # still evolving its target boundaries.
    deps = [
      "//base",
      "//chrome/android:jni_headers",
      "//chrome/browser:browser",
      "//chrome/browser/extensions",
      "//components/crx_file",
      "//content/public/browser",
      "//extensions/browser",
      "//extensions/common",
    ]
  }
}

source_set("tabs_public") {
  public = [ "brave_tab_features.h" ]

  public_deps = [ "//chrome/browser/android:tabs_public" ]
}

source_set("tabs_impl") {
  visibility = [ "//brave/browser:core" ]
  sources = [ "brave_tab_features.cc" ]

  deps = [
    ":tabs_public",
    "//base",
    "//brave/browser/ai_chat",
    "//brave/browser/misc_metrics:misc_metrics_impl",
    "//brave/components/misc_metrics",
    "//chrome/browser/profiles:profile",
    "//content/public/browser",
  ]
}
